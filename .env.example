# Copy to .env and fill in. Everything here is optional — Scout runs with no .env at all.
# .env is gitignored; this sample is the only env file that gets committed.
#
# Variables that have a working default are left commented out on purpose. Bun loads .env
# automatically, so an uncommented `SCOUT_PORT=` would set an empty string rather than leave
# the variable unset. Scout treats blank as unset anyway, but commenting keeps `.env` honest
# about what is actually configured.

# --- Job source API keys ---------------------------------------------------------------
# Adzuna aggregates Indeed/LinkedIn/Glassdoor inventory. Free tier, needs BOTH values:
# the app id and the app key are issued together at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# USAJobs is the US federal hiring API — real employers, no reposts. Free key from
# https://developer.usajobs.gov/apirequest/ . The API also requires the email address the
# key was registered with, sent as the User-Agent header, so both values are needed.
# USA_JOBS_EMAIL identifies the API key to USAJobs and nothing else — it is not the address
# applications are sent from, so leave it matching the account the key was issued to.
USA_JOBS_API_KEY=
USA_JOBS_EMAIL=

# --- Profile ingestion ----------------------------------------------------------------
# Lifts the GitHub API limit from 60 requests/hour to 5000 and includes private repos.
# `gh auth token` is used automatically when this is unset, so it is rarely needed.
# Needs no scopes beyond repo read.
GITHUB_TOKEN=

# GitHub account to ingest repositories from. Defaults to kevingastelum.
# SCOUT_GITHUB_USER=

# Semicolon- or comma-separated roots scanned for local checkouts.
# Defaults to ~/Documents/Coding and ~/Projects.
# SCOUT_LOCAL_REPO_ROOTS=

# --- Paths and runtime ----------------------------------------------------------------
# SQLite database location. Defaults to ./scout.db
# SCOUT_DB=

# Port for `bun run serve`. Defaults to 8787, bound to 127.0.0.1 only.
# SCOUT_PORT=

# Profile file overrides. Defaults: profile/profile.md, profile/profile.json,
# profile/generated.json
# SCOUT_PROFILE_MD=
# SCOUT_PROFILE=
# SCOUT_PROFILE_GENERATED=

# Model passed to the local `claude` CLI. Defaults to claude-sonnet-5.
# There is no API key here by design — every LLM call spawns the CLI against your
# Claude subscription.
# SCOUT_MODEL=
