# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
project_id        = "scout-123456"
# Casing must match GitHub exactly — this lands in the OIDC `assertion.repository` claim,
# and a case-mismatched value silently fails every token exchange.
github_repository = "KevinGastelum/scout-job-finder"

# region = "us-central1"
# name   = "scout"
# cluster_deletion_protection = false
