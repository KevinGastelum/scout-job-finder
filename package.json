{
  "name": "scout",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "scan": "bun run scripts/scan.ts",
    "profile": "bun run scripts/compile-profile.ts",
    "ingest": "bun run scripts/ingest-profile.ts && bun run profile",
    "intel": "bun run scripts/intel.ts",
    "verify-boards": "bun run scripts/verify-boards.ts",
    "serve": "bun run packages/server/src/index.ts",
    "web:dev": "vite --config packages/web/vite.config.ts",
    "web:build": "vite build --config packages/web/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
